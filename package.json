{
  "name": "omg",
  "version": "1.28.1",
  "license": "MIT",
  "scripts": {
    "ng": "./node_modules/@angular/cli/bin/ng",
    "start-mock": "ng serve -H 0.0.0.0 --environment=mock",
    "start-https": "ng serve --ssl true --sslKey /node_modules/browser-sync/certs/server.key --sslCert /node_modules/browser-sync/certs/server.crt",
    "start": "cd dist && ../node_modules/live-server/live-server.js --port=8081 --host=localhost --entry-file=/index.html --no-browser",
    "build": "ng build",
    "test": "echo 'no test'",
    "lint": "",
    "e2e": "node e2e/home.js",
    "compodoc": "./node_modules/.bin/compodoc -p src/tsconfig.app.json -d docs/",
    "build--stage": "ng build --prod --environment=stage --stats-json --source-map=true --named-chunks=true && npm run sw",
    "build--hotfix": "ng build --prod --env=hotfix --no-sourcemap --stats-json && npm run sw",
    "build--prod": "ng build --prod --no-sourcemap --stats-json && npm run sw",
    "sw": "sw-precache --root=dist --config=sw-precache-config.js",
    "static-serve": "cd dist && live-server --port=8081 --host=localhost --entry-file=/index.html"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^4.2.6",
    "@angular/common": "^4.2.6",
    "@angular/compiler": "^4.2.6",
    "@angular/core": "^4.2.6",
    "@angular/forms": "^4.2.6",
    "@angular/http": "^4.2.6",
    "@angular/platform-browser": "^4.4.3",
    "@angular/platform-browser-dynamic": "^4.2.6",
    "@angular/router": "^4.2.6",
    "@auth0/angular-jwt": "^1.1.0",
    "@ngrx/core": "^1.2.0",
    "@ngrx/effects": "^2.0.4",
    "@ngrx/store": "^2.2.1",
    "@ngrx/store-devtools": "^3.2.4",
    "@types/jspdf": "^1.1.31",
    "angular-custom-modal": "^1.0.0",
    "angular-io-datepicker": "^1.3.1",
    "bootstrap": "^3.4.1",
    "bootstrap-sass": "^3.3.7",
    "chart.js": "^2.7.3",
    "core-js": "^2.4.1",
    "font-awesome": "4.6.3",
    "goog-webfont-dl": "^1.0.3",
    "immutable": "^3.8.1",
    "jspdf": "^1.3.5",
    "jspdf-autotable": "^2.3.2",
    "live-server": "^1.2.1",
    "ngx-bootstrap": "^2.0.5",
    "open": "^6.1.0",
    "primeng": "^4.3.0-rc.1",
    "puppeteer": "^1.19.0",
    "reselect": "^2.5.4",
    "rxjs": "5.5.6",
    "xlsx": "^0.15.6",
    "zone.js": "0.8.7"
  },
  "devDependencies": {
    "@angular/cli": "^1.5.5",
    "@angular/compiler-cli": "^4.2.6",
    "@angularclass/hmr": "^1.2.2",
    "@compodoc/compodoc": "^1.1.10",
    "@types/grecaptcha": "^2.0.31",
    "@types/jasmine": "2.5.38",
    "@types/morris.js": "^0.5.6",
    "@types/node": "~6.0.60",
    "browser-sync": "^2.26.7",
    "codelyzer": "^2.0.1",
    "jasmine-core": "^2.5.2",
    "jasmine-spec-reporter": "^3.2.0",
    "karma": "^1.4.1",
    "karma-chrome-launcher": "^2.0.0",
    "karma-cli": "^1.0.1",
    "karma-coverage-istanbul-reporter": "^0.2.3",
    "karma-jasmine": "^1.1.0",
    "karma-jasmine-html-reporter": "^0.2.2",
    "ngrx-store-freeze": "^0.1.9",
    "node-sass": "^4.14.1",
    "nswag": "10.6.0",
